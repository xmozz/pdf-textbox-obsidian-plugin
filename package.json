{
  "name": "pdf-textbox",
  "version": "0.2.0",
  "description": "Adds editable Markdown/LaTeX textboxes to Obsidian's native PDF viewer and can burn them into the PDF.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/test.mjs",
    "bench": "node scripts/benchmark.mjs",
    "test-vault": "npm run build && node scripts/create-test-vault.mjs",
    "test-vault:reset": "npm run build && node scripts/create-test-vault.mjs --reset",
    "test-vault:stress": "npm run build && node scripts/create-test-vault.mjs --stress --dir=test-vault-stress"
  },
  "keywords": [
    "obsidian",
    "pdf",
    "annotation",
    "textbox"
  ],
  "author": "xmozz",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "pdf-lib": "^1.17.1"
  }
}
